# Only what ships goes into the repository. Everything else in this folder (probe results,
# old builds, the development handoff, the tools) stays local.
/*
!/.gitignore
!/addon/
!/build.ps1
!/README.md
!/LICENSE
!/CHANGELOG.md

__pycache__/
*.pyc
# Generated by build.ps1 from readme.md.
/addon/doc/en/readme.html
